# Omit DATABASE_URL to use persistent local PGlite in .data/db.
# DATABASE_URL=postgresql://...neon.tech/bandarlog?sslmode=verify-full
PORT=3001
APP_URL=http://localhost:5173
# Production additionally requires AUTH_CHALLENGE_SECRET (32+ random characters) and a configured mail transport.
# BOOTSTRAP_EMAIL=coordinacion@example.org
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=grupo@example.org
# SMTP_PASS=
# MAIL_FROM=Bandarlog <grupo@example.org>

# Railway Free/Trial/Hobby: use Gmail HTTPS API instead of SMTP.
# MAIL_TRANSPORT=gmail_api
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Required private server secret in production; use a stable random value of at least 32 characters.
# AUTH_CHALLENGE_SECRET=
# Optional Google SIGN-IN client, separate from GMAIL_* used for sending mail.
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
# Register the exact redirect URI: <APP_URL>/api/auth/google/callback
