# Template only. Keep actual secrets in Railway Variables; do not commit .env.
NODE_ENV=production
APP_URL=https://bandarlog.app
LEGACY_APP_ORIGINS=https://bandarlog-production.up.railway.app
# Keep the existing Neon database URL, including sslmode=verify-full.
DATABASE_URL=
AUTH_CHALLENGE_SECRET=
MAIL_TRANSPORT=resend
MAIL_FROM=Bandarlog <notifications@bandarlog.app>
RESEND_API_KEY=
# Optional legacy Gmail API sending alternative (not used by Resend).
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Used only on a completely empty database, not to recreate existing accounts.
BOOTSTRAP_EMAIL=
# Optional sign-in client, separate from the Gmail sending authorization.
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
# Shared callback for every group: https://bandarlog.app/api/auth/google/callback
