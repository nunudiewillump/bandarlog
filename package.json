{
  "name": "bandarlog",
  "version": "1.0.0",
  "description": "Gestión de comisiones y seguimiento de tareas para un grupo scout",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "import": "node --env-file-if-exists=.env --import tsx server/import.ts",
    "format": "prettier --write src server tests *.ts *.json *.html",
    "ai:package": "node scripts/export-ai-space.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunudiewillump/bandarlog.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nunudiewillump/bandarlog/issues"
  },
  "homepage": "https://github.com/nunudiewillump/bandarlog#readme",
  "private": true,
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@radix-ui/react-select": "^2.4.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.62.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
